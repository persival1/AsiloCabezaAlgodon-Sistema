<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>125d912e-6a01-433f-9c94-c3472f2adf63</UserSecretsId>
		<!-- AC-15: versión de la entrega; el commit lo agrega el despliegue (SourceRevisionId) -->
		<Version>1.0.0-rc2</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MediatR" Version="14.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Mantenemos la librería de OpenAPI en su versión 1.x para compatibilidad con Swashbuckle -->
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<!-- La configuración de desarrollo (con la llave JWT de prueba) no se copia al publicar:
	     en un servidor no se usa y no debe viajar con la aplicación. -->
	<ItemGroup>
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AsiloCabezaAlgodon.Application\AsiloCabezaAlgodon.Application.csproj" />
		<ProjectReference Include="..\AsiloCabezaAlgodon.Infrastructure\AsiloCabezaAlgodon.Infrastructure.csproj" />
	</ItemGroup>

</Project>