{
  // EJEMPLO de configuración para un servidor real. No se usa tal cual: sirve de guía.
  // Para usarlo, copiar este archivo como appsettings.Production.json (ese nombre ya
  // queda fuera del repositorio por el .gitignore) y llenar los valores.
  //
  // Los secretos NO se escriben en archivos: se entregan como variables de entorno
  // (en Windows: Panel de control > Variables de entorno, o la configuración del hosting).
  // ASP.NET Core convierte "__" (dos guiones bajos) en ":" de la configuración:
  //
  //   Jwt__Key                         -> Jwt:Key  (mínimo 32 caracteres, aleatoria)
  //   ConnectionStrings__DefaultConnection
  //   Smtp__Host, Smtp__Usuario, Smtp__Password, Smtp__Remitente
  //   ASPNETCORE_ENVIRONMENT=Production
  //
  // En Production el SeedController responde 404 y Swagger está desactivado.

  "ConnectionStrings": {
    "DefaultConnection": "Server=SERVIDOR;Database=asilo_cabeza_algodon;User Id=USUARIO;Password=CAMBIAR;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "AsiloCabezaAlgodonAPI",
    "Audience": "AsiloCabezaAlgodonClientes"
  },
  "Cors": {
    "Origenes": [ "https://tu-dominio.com" ]
  },
  "Smtp": {
    "Host": "smtp.ejemplo.com",
    "Puerto": "587",
    "Usuario": "CAMBIAR",
    "Password": "CAMBIAR",
    "Remitente": "no-responder@ejemplo.com"
  },
  "AllowedHosts": "tu-dominio.com"
}
